{
	"name": "manara-studio",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					}
				}
			},
			"Shared": {
				"$path": "out/shared"
			}
		},
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"Server": {
				"$path": "out/server"
			}
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"Client": {
					"$path": "out/client"
				}
			}
		},
		"Workspace": {
			"$className": "Workspace",
			"$properties": {
				"FilteringEnabled": true
			}
		},
		"Lighting": {
			"$className": "Lighting",
			"$properties": {
				"Ambient": [0.3, 0.3, 0.3],
				"Brightness": 2,
				"GlobalShadows": true
			}
		}
	}
}
